# GC File Site — Apache configuration.
# Data folders and includes are not served directly; every file goes through PHP.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # The converter tab frames the same-origin Python service. GC pages keep
    # their stricter CSP frame-ancestors 'none' from bootstrap.php.
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "^(schema\.sql|README\.md|CLAUDE\.md|.*\.ini|db\.php|session\.php|bootstrap\.php|layout\.php|converter_lib\.php)$">
    Require all denied
</FilesMatch>

# Converter service: /convert/* is served by the authenticated PHP proxy.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^convert(?:/(.*))?$ converter_proxy.php [L,QSA]
</IfModule>

RedirectMatch 404 "(?i)/(?:uploads|updates|docs|\.claude|\.githooks)(?:/|$)"

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
